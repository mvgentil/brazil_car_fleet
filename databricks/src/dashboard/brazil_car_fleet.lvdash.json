{
  "datasets": [
    {
      "name": "ds_ev_penetration",
      "displayName": "EV and hybrid penetration",
      "queryLines": [
        "WITH totals AS (\n",
        "  SELECT\n",
        "    dt_referencia,\n",
        "    nr_ano,\n",
        "    nr_mes,\n",
        "    SUM(qt_veiculos) AS total_veiculos,\n",
        "    SUM(CASE WHEN nm_grupo IN ('Elétrico Puro', 'Híbrido') THEN qt_veiculos ELSE 0 END) AS veiculos_eletricos_hibridos\n",
        "  FROM brazil_car_fleet.gold.frota_por_grupo_combustivel_regiao\n",
        "  GROUP BY dt_referencia, nr_ano, nr_mes\n",
        ")\n",
        "SELECT\n",
        "  dt_referencia AS reference_date,\n",
        "  nr_ano,\n",
        "  nr_mes,\n",
        "  veiculos_eletricos_hibridos,\n",
        "  total_veiculos,\n",
        "  veiculos_eletricos_hibridos / NULLIF(total_veiculos, 0) AS penetration_rate\n",
        "FROM totals\n",
        "ORDER BY reference_date"
      ],
      "catalog": "brazil_car_fleet",
      "schema": "gold"
    },
    {
      "name": "ds_ev_latest",
      "displayName": "Latest EV and hybrid penetration",
      "queryLines": [
        "WITH totals AS (\n",
        "  SELECT\n",
        "    dt_referencia,\n",
        "    SUM(qt_veiculos) AS total_veiculos,\n",
        "    SUM(CASE WHEN nm_grupo IN ('Elétrico Puro', 'Híbrido') THEN qt_veiculos ELSE 0 END) AS veiculos_eletricos_hibridos\n",
        "  FROM brazil_car_fleet.gold.frota_por_grupo_combustivel_regiao\n",
        "  WHERE dt_referencia = (SELECT MAX(dt_referencia) FROM brazil_car_fleet.gold.frota_por_grupo_combustivel_regiao)\n",
        "  GROUP BY dt_referencia\n",
        ")\n",
        "SELECT\n",
        "  veiculos_eletricos_hibridos,\n",
        "  total_veiculos,\n",
        "  veiculos_eletricos_hibridos / NULLIF(total_veiculos, 0) AS penetration_rate\n",
        "FROM totals"
      ],
      "catalog": "brazil_car_fleet",
      "schema": "gold"
    },
    {
      "name": "ds_fleet_growth",
      "displayName": "Fleet growth by region",
      "queryLines": [
        "SELECT\n",
        "  nm_regiao,\n",
        "  qt_frota_inicio AS frota_inicio,\n",
        "  qt_frota_fim AS frota_fim,\n",
        "  crescimento_absoluto,\n",
        "  crescimento_pct / 100.0 AS growth_rate\n",
        "FROM brazil_car_fleet.gold.frota_crescimento_por_regiao\n",
        "WHERE nm_regiao IS NOT NULL\n",
        "ORDER BY growth_rate DESC"
      ],
      "catalog": "brazil_car_fleet",
      "schema": "gold"
    },
    {
      "name": "ds_regional_concentration",
      "displayName": "Regional concentration",
      "queryLines": [
        "WITH latest AS (\n",
        "  SELECT MAX(dt_referencia) AS max_dt FROM brazil_car_fleet.gold.frota_por_grupo_combustivel_regiao\n",
        "),\n",
        "reg AS (\n",
        "  SELECT\n",
        "    nm_regiao,\n",
        "    SUM(qt_veiculos) AS frota_regional\n",
        "  FROM brazil_car_fleet.gold.frota_por_grupo_combustivel_regiao\n",
        "  WHERE dt_referencia = (SELECT max_dt FROM latest)\n",
        "    AND nm_regiao IS NOT NULL\n",
        "  GROUP BY nm_regiao\n",
        ")\n",
        "SELECT\n",
        "  nm_regiao,\n",
        "  frota_regional,\n",
        "  frota_regional / (SELECT SUM(frota_regional) FROM reg) AS national_share\n",
        "FROM reg\n",
        "ORDER BY frota_regional DESC"
      ],
      "catalog": "brazil_car_fleet",
      "schema": "gold"
    },
    {
      "name": "ds_mom_growth",
      "displayName": "Monthly growth by fuel group",
      "queryLines": [
        "SELECT\n",
        "  dt_referencia AS reference_date,\n",
        "  nm_grupo,\n",
        "  qt_veiculos AS total_veiculos,\n",
        "  crescimento_mom_pct / 100.0 AS mom_growth_rate\n",
        "FROM brazil_car_fleet.gold.frota_crescimento_mom_por_combustivel\n",
        "WHERE nm_grupo NOT IN ('Não Identificado', 'Combustão Renovável')\n",
        "ORDER BY reference_date, nm_grupo"
      ],
      "catalog": "brazil_car_fleet",
      "schema": "gold"
    },
    {
      "name": "ds_yoy_growth_latest",
      "displayName": "Latest annual growth by fuel and region",
      "queryLines": [
        "SELECT\n",
        "  nm_regiao,\n",
        "  nm_grupo,\n",
        "  qt_veiculos AS total_veiculos,\n",
        "  crescimento_yoy_pct / 100.0 AS yoy_growth_rate\n",
        "FROM brazil_car_fleet.gold.frota_crescimento_yoy_por_combustivel_regiao\n",
        "WHERE dt_referencia = (SELECT MAX(dt_referencia) FROM brazil_car_fleet.gold.frota_crescimento_yoy_por_combustivel_regiao)\n",
        "  AND nm_regiao IS NOT NULL\n",
        "  AND nm_grupo != 'Não Identificado'\n",
        "ORDER BY nm_regiao, nm_grupo"
      ],
      "catalog": "brazil_car_fleet",
      "schema": "gold"
    },
    {
      "name": "ds_top_municipios",
      "displayName": "Top 10 municípios por frota geral",
      "queryLines": [
        "SELECT\n",
        "  nm_municipio,\n",
        "  sigla_uf,\n",
        "  nm_regiao,\n",
        "  SUM(qt_veiculos_total) AS total_frota\n",
        "FROM brazil_car_fleet.gold.frota_municipio_ranking\n",
        "WHERE nm_municipio NOT IN ('SEM INFORMACAO', 'SEM INFORMAÇÃO', 'NAO IDENTIFICADO', 'NÃO IDENTIFICADO', 'NAO SE APLICA', 'VIDE/CAMPO/OBSERVACAO')\n",
        "  AND sigla_uf IS NOT NULL\n",
        "GROUP BY nm_municipio, sigla_uf, nm_regiao\n",
        "ORDER BY total_frota DESC\n",
        "LIMIT 10"
      ],
      "catalog": "brazil_car_fleet",
      "schema": "gold"
    },
    {
      "name": "ds_qualidade_dados",
      "displayName": "Qualidade de dados por estado",
      "queryLines": [
        "SELECT\n",
        "  sigla_uf,\n",
        "  nm_uf,\n",
        "  nm_regiao,\n",
        "  qt_total,\n",
        "  qt_nao_identificado,\n",
        "  pct_nao_identificado / 100.0 AS pct_nao_identificado\n",
        "FROM brazil_car_fleet.gold.frota_qualidade_dados\n",
        "WHERE dt_referencia = (SELECT MAX(dt_referencia) FROM brazil_car_fleet.gold.frota_qualidade_dados)\n",
        "  AND sigla_uf IS NOT NULL\n",
        "ORDER BY pct_nao_identificado DESC"
      ],
      "catalog": "brazil_car_fleet",
      "schema": "gold"
    },
    {
      "name": "ds_ev_growth_by_region",
      "displayName": "Crescimento acumulado EV/Híbridos por região",
      "queryLines": [
        "WITH periods AS (\n",
        "  SELECT\n",
        "    MIN(dt_referencia) AS min_dt,\n",
        "    MAX(dt_referencia) AS max_dt\n",
        "  FROM brazil_car_fleet.gold.frota_eletrica_e_hibrida_evolucao\n",
        "  WHERE nm_regiao IS NOT NULL\n",
        "),\n",
        "regional AS (\n",
        "  SELECT\n",
        "    dt_referencia,\n",
        "    nm_regiao,\n",
        "    SUM(qt_veiculos) AS total_ev_hybrid\n",
        "  FROM brazil_car_fleet.gold.frota_eletrica_e_hibrida_evolucao\n",
        "  WHERE nm_regiao IS NOT NULL\n",
        "  GROUP BY dt_referencia, nm_regiao\n",
        "),\n",
        "inicio AS (\n",
        "  SELECT\n",
        "    nm_regiao,\n",
        "    total_ev_hybrid AS frota_inicio\n",
        "  FROM regional\n",
        "  WHERE dt_referencia = (SELECT min_dt FROM periods)\n",
        "),\n",
        "fim AS (\n",
        "  SELECT\n",
        "    nm_regiao,\n",
        "    total_ev_hybrid AS frota_fim\n",
        "  FROM regional\n",
        "  WHERE dt_referencia = (SELECT max_dt FROM periods)\n",
        ")\n",
        "SELECT\n",
        "  i.nm_regiao,\n",
        "  i.frota_inicio,\n",
        "  f.frota_fim,\n",
        "  (f.frota_fim - i.frota_inicio) AS crescimento_absoluto,\n",
        "  (f.frota_fim - i.frota_inicio) / NULLIF(i.frota_inicio, 0) AS growth_rate\n",
        "FROM inicio i\n",
        "JOIN fim f ON i.nm_regiao = f.nm_regiao\n",
        "ORDER BY growth_rate DESC"
      ],
      "catalog": "brazil_car_fleet",
      "schema": "gold"
    },
    {
      "name": "ds_ranking_estados_ev",
      "displayName": "Ranking de estados com mais EV/Híbridos",
      "queryLines": [
        "WITH latest AS (\n",
        "  SELECT MAX(dt_referencia) AS max_dt FROM brazil_car_fleet.gold.frota_eletrica_e_hibrida_evolucao\n",
        "),\n",
        "agg AS (\n",
        "  SELECT\n",
        "    sigla_uf,\n",
        "    nm_uf,\n",
        "    nm_regiao,\n",
        "    SUM(CASE WHEN nm_grupo = 'Elétrico Puro' THEN qt_veiculos ELSE 0 END) AS veiculos_eletricos_puros,\n",
        "    SUM(CASE WHEN nm_grupo = 'Híbrido' THEN qt_veiculos ELSE 0 END) AS veiculos_hibridos,\n",
        "    SUM(qt_veiculos) AS total_eletricos_hibridos\n",
        "  FROM brazil_car_fleet.gold.frota_eletrica_e_hibrida_evolucao\n",
        "  WHERE dt_referencia = (SELECT max_dt FROM latest)\n",
        "    AND sigla_uf IS NOT NULL\n",
        "  GROUP BY sigla_uf, nm_uf, nm_regiao\n",
        ")\n",
        "SELECT\n",
        "  sigla_uf,\n",
        "  nm_uf,\n",
        "  nm_regiao,\n",
        "  veiculos_eletricos_puros,\n",
        "  veiculos_hibridos,\n",
        "  total_eletricos_hibridos,\n",
        "  RANK() OVER (ORDER BY total_eletricos_hibridos DESC) AS rank_nacional\n",
        "FROM agg\n",
        "ORDER BY total_eletricos_hibridos DESC"
      ],
      "catalog": "brazil_car_fleet",
      "schema": "gold"
    }
  ],
